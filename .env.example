# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# -----------------------------
# Database
# -----------------------------
DB_URL=jdbc:postgresql://localhost:5432/shelflife
DB_USER=shelflife
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# -----------------------------
# JWT
# -----------------------------
# Any long random string. Rotating this invalidates every issued access/refresh token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=shelflife
JWT_AUDIENCE=shelflife-clients
JWT_ACCESS_TOKEN_EXPIRATION=15
JWT_REFRESH_TOKEN_EXPIRATION=10080

# -----------------------------
# Security
# -----------------------------
# A server-side secret mixed into every password hash in addition to its random salt.
# Losing this value does not itself expose passwords, but changing it invalidates every
# existing password hash (users would need to reset their password).
PASSWORD_PEPPER=change-me-to-a-long-random-string

# -----------------------------
# CORS
# -----------------------------
# Comma-separated list of allowed origins (host:port, no scheme) for production traffic.
# Leave blank in production until you know the real frontend origin(s) — CORS fails closed.
CORS_ALLOWED_HOSTS=

# -----------------------------
# Email (Resend)
# -----------------------------
# Leave blank to fall back to LoggingEmailService, which just logs verification emails
# instead of sending them — convenient for local development.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# -----------------------------
# Misc
# -----------------------------
ENVIRONMENT=local
APP_BASE_URL=http://localhost:8080
