# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# -----------------------------
# Database
# -----------------------------
DB_URL=jdbc:postgresql://localhost:5432/mozgobolt
DB_USER=mozgobolt
DB_PASSWORD=change-me

# -----------------------------
# Runtime capacity (per backend instance)
# -----------------------------
# HikariCP's default starting point; tune against database capacity and total replica count.
DB_POOL_SIZE=10
# Optional maximum concurrent Argon2 password operations; defaults to available CPU cores.
# Each operation uses about 64 MiB. Lower this if memory is constrained; tune against real load.
# PASSWORD_HASH_CONCURRENCY=2
# Optional concurrent image processing limit; defaults to available CPU cores.
# IMAGE_PROCESSING_CONCURRENCY=2

# -----------------------------
# JWT
# -----------------------------
# Generate at least 32 random bytes. Production startup rejects this example placeholder and
# secrets shorter than 32 bytes. Rotating this invalidates every issued access/refresh token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=mozgobolt
JWT_AUDIENCE=mozgobolt-clients
JWT_ACCESS_TOKEN_EXPIRATION=15
JWT_REFRESH_TOKEN_EXPIRATION=10080

# -----------------------------
# Security
# -----------------------------
# Generate at least 32 random bytes, distinct from JWT_SECRET. Production startup rejects this
# example placeholder and secrets shorter than 32 bytes. It is mixed into every password hash
# in addition to its random salt.
# Losing this value does not itself expose passwords, but changing it invalidates every
# existing password hash (users would need to reset their password).
PASSWORD_PEPPER=change-me-to-a-long-random-string

# -----------------------------
# CORS
# -----------------------------
# Comma-separated list of allowed origins (host:port, no scheme) for production traffic.
# Leave blank in production until you know the real frontend origin(s) — CORS fails closed.
CORS_ALLOWED_HOSTS=

# -----------------------------
# Email (Resend)
# -----------------------------
# Leave blank to keep email messages encrypted in the local outbox without delivering them.
# Configure a Resend API key to process verification and password-reset emails.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# -----------------------------
# Vehicle pictures
# -----------------------------
# Local directory images are stored under. Leave unset for the default (./data/vehicle-images).
VEHICLE_IMAGE_STORAGE_DIR=

# -----------------------------
# ClamAV (required in production for uploaded vehicle pictures)
# -----------------------------
# Keep disabled for local development unless a clamd daemon is running. Production startup refuses
# to run with this disabled. If enabled but the scanner is unavailable, uploads fail closed with
# HTTP 503; infected or invalid images are rejected. Image sanitization/re-encoding also runs.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# -----------------------------
# Object storage (Cloudflare R2, or any other S3-compatible backend)
# -----------------------------
# Leave disabled to store vehicle pictures on local disk instead (see VEHICLE_IMAGE_STORAGE_DIR
# above). To use R2: Cloudflare dashboard -> R2 -> create a bucket -> Manage API Tokens -> create
# an API token with Object Read & Write -> use the Access Key ID/Secret Access Key it gives you.
# The endpoint is https://<account-id>.r2.cloudflarestorage.com (account id is on the R2 overview
# page). Region is always "auto" for R2 — it's only used for request signing, not addressing.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
# Optional — leave unset for the defaults (30000/10000). Bounds one whole S3 call (retries
# included) and each individual attempt, so a wedged endpoint can't hang a request forever.
OBJECT_STORAGE_API_CALL_TIMEOUT_MS=
OBJECT_STORAGE_API_CALL_ATTEMPT_TIMEOUT_MS=

# -----------------------------
# Push notifications (Firebase Cloud Messaging)
# -----------------------------
# Leave disabled to fall back to LoggingPushNotificationSender, which just logs that a push
# would have been sent instead of sending it — convenient for local development. To enable: create
# a Firebase project -> Project settings -> Service accounts -> Generate new private key. Paste the
# entire downloaded JSON file's contents as one line into FCM_SERVICE_ACCOUNT_JSON. The project id
# is not configured separately — the firebase-admin SDK reads it from this same JSON.
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------
# Cross-instance fanout (Redis)
# -----------------------------
# Leave unset to run in single-instance mode — every real-time hub (the live vehicle map, ping
# delivery) falls back to NoOpMessageRelay and works exactly as it does without Redis at all. Only
# set this once you run more than one instance of this app behind a load balancer, so each
# instance's in-memory hub learns about updates that landed on a different instance. Local dev:
# `docker compose up redis` starts one at redis://localhost:6379.
REDIS_URL=

# -----------------------------
# Sentry (error tracking)
# -----------------------------
# Leave blank to disable — no events are sent, nothing else changes. Every logger.error(throwable)
# call in the app becomes a Sentry issue automatically once set; no code changes needed elsewhere.
# Get a DSN: sentry.io -> create project (Kotlin) -> Settings -> Client Keys (DSN).
SENTRY_DSN=
# Optional, separate from the app entirely: lets `./gradlew build` upload source code to Sentry so
# stack traces in the dashboard show real source, not just class/line. Read directly by
# build.gradle.kts at build time (see readLocalSecret there) — a real env var always wins over this
# file, so a CI secret named the same works without any code change. Get one: Sentry -> org
# settings -> Auth Tokens.
SENTRY_AUTH_TOKEN=

# -----------------------------
# Misc
# -----------------------------
ENVIRONMENT=local
APP_BASE_URL=http://localhost:8080
# Optional directory for rolling JSON log files (defaults to ./logs); production also writes JSON to stdout.
LOG_DIR=./logs
